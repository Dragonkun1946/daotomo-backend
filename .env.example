# ─── Core ───────────────────────────────────────────────
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/daotomo
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://www.daotomo.site

# ─── Password reset email (SMTP) ────────────────────────
# Any SMTP provider works (Gmail app-password, SendGrid, Resend, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Đảo Tò Mò <no-reply@daotomo.site>"

# ─── Discord OAuth ───────────────────────────────────────
# Create an app at https://discord.com/developers/applications
# Redirect URI must exactly match DISCORD_CALLBACK_URL below
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=https://daotomo-backend.onrender.com/api/auth/discord/callback
